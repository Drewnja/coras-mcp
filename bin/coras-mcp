#!/usr/bin/env bash
# Runs the CORAS MCP server over stdio, from anywhere.
#
#   claude mcp add coras -s user -- /path/to/coras-mcp/bin/coras-mcp
#
# Needs nothing but a python3 on PATH (3.8 or newer). Set CORAS_PYTHON to pick
# a particular interpreter, CORAS_TOOL_DIR to point at the Threat Modelling
# Tool's folder, and CORAS_JAVA to pick a JDK/JRE.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
project="$(cd "$here/.." && pwd)"

python_bin="${CORAS_PYTHON:-}"
if [ -z "$python_bin" ]; then
  for candidate in python3 python3.13 python3.12 python3.11 python3.10 python3.9 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      python_bin="$candidate"
      break
    fi
  done
fi
if [ -z "$python_bin" ]; then
  echo "error: no python3 on PATH; set CORAS_PYTHON to one" >&2
  exit 1
fi

export PYTHONPATH="$project${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1
exec "$python_bin" -m coras_mcp "$@"
